WIKI_PATH=./wiki
RAW_PATH=./raw
# Una riga che dice quale dominio documenta la wiki collegata: finisce nelle
# `instructions` che il client MCP riceve alla connessione. Il server è
# domain-agnostic, quindi va impostata per ogni istanza — altrimenti il client
# riceve solo una descrizione generica.
#WIKI_DOMAIN=Questa wiki documenta il dominio di <...>.
# Fuso con cui rendere le date derivate dall'mtime (es. "Europe/Rome").
# Utile se il server gira in una macchina con fuso diverso da quello degli utenti.
# Se assente si usa il fuso della macchina.
#WIKI_TZ=Europe/Rome

# --- Solo per src/http.ts (accesso remoto, sola lettura) ---
# Porta di ascolto del server HTTP.
#MCP_HTTP_PORT=3000
# Indirizzo di ascolto. Default 127.0.0.1 (solo loopback): per esporre il server
# fuori dalla macchina (es. in un container) imposta 0.0.0.0, meglio dietro un
# reverse proxy con TLS.
#MCP_HTTP_HOST=127.0.0.1
# Rate limit per IP sulle richieste con token errato o mancante: dopo
# MCP_HTTP_RATE_LIMIT_MAX fallimenti entro MCP_HTTP_RATE_LIMIT_WINDOW_SECONDS
# secondi si risponde 429 con Retry-After. Default 10 fallimenti / 60 secondi.
#MCP_HTTP_RATE_LIMIT_MAX=10
#MCP_HTTP_RATE_LIMIT_WINDOW_SECONDS=60
# Token Bearer richiesto per autenticare le richieste HTTP. Obbligatorio: senza,
# il processo si rifiuta di avviarsi. Genera un valore casuale, es. `openssl rand -hex 32`.
#MCP_HTTP_TOKEN=
# Di default l'accesso HTTP serve solo le pagine della wiki. Con `true` (valore esatto)
# monta anche i tool sulle sorgenti raw/ (wikiListRaw, wikiReadRaw, wikiRawDiff,
# wikiChecksum): attivalo solo se RAW_PATH contiene materiale leggibile da chiunque
# abbia il token.
#MCP_HTTP_EXPOSE_RAW=true
