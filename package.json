{
  "name": "wiki-mcp-api",
  "version": "0.1.0",
  "description": "MCP server per la wiki di dominio LLM Wiki",
  "type": "module",
  "bin": "dist/stdio.js",
  "scripts": {
    "build": "tsup src/stdio.ts src/http.ts --format esm --no-splitting --dts && node -e \"const fs=require('fs');const f='dist/stdio.js';fs.writeFileSync(f,'#!/usr/bin/env node\\n'+fs.readFileSync(f,'utf8'));\" && chmod +x dist/stdio.js",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "test": "vitest run",
    "lint": "eslint src tests && tsc -p tsconfig.check.json",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@mastra/core": "^1.61.0",
    "@mastra/mcp": "^1.17.1",
    "dotenv": "^16.0.0",
    "gray-matter": "^4.0.3",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.1.11"
  }
}
